# Databricks MCP server configuration.
# Copy to databricks_mcp/.env for local testing, or set these as the `env`
# block in your Claude client's MCP config. Never commit real tokens.

# Workspace URL, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=

# Personal access token (dapi...). Prefer a token whose Unity Catalog grants are
# read-only on the schemas you want reachable — that is the real safety boundary.
DATABRICKS_TOKEN=

# SQL warehouse to run queries on. Databricks UI -> SQL Warehouses -> your
# warehouse -> the id in its URL (or under Connection details).
DATABRICKS_WAREHOUSE_ID=

# --- Optional overrides (defaults shown) ---

# Where Sentinel's tables live.
# DATABRICKS_MCP_CATALOG=workspace
# DATABRICKS_MCP_SCHEMA=sentinel

# Hard cap on rows a single preview/query can pull into the chat.
# DATABRICKS_MCP_MAX_ROWS=1000

# Set to 1/true to allow writes (non-SELECT SQL and trigger_job). Off by default.
# DATABRICKS_MCP_ALLOW_WRITES=
